# Primary LLM API Key (Google AI Studio)
GEMINI_API_KEY=your_api_key_here

# Fallback LLM API Key (Groq Console)
GROQ_API_KEY=your_api_key_here
# GitHub Access Token (Optional, but highly recommended to avoid API rate limits)
GITHUB_TOKEN=your_github_token_here

# Directory where Chroma vector DB will store its index locally
CHROMA_DIR=./chroma_db
